.woocommerce-checkout .thwcfd-field-radio{display:flex;flex-direction:column;gap:10px;margin:0 0 18px;}.woocommerce-checkout .thwcfd-field-radio>label{display:block;margin:0;color:#143451;font-weight:600;line-height:1.35;}.woocommerce-checkout .thwcfd-field-radio .woocommerce-input-wrapper{display:flex;flex-wrap:wrap;gap:14px 24px;align-items:center;}.woocommerce-checkout .thwcfd-field-radio .woocommerce-input-wrapper label{display:inline-flex;align-items:center;gap:8px;margin:0;color:#0b253c;font-weight:400;line-height:1.35;}.woocommerce-checkout .thwcfd-field-radio input[type=radio]{width:16px;height:16px;margin:0;accent-color:#ff9c23;}.woocommerce-checkout .ufin-checkout-single-option{display:flex;flex-direction:column;gap:10px;margin:0 0 18px;}.woocommerce-checkout .ufin-checkout-single-option .woocommerce-input-wrapper label{display:inline-flex;align-items:center;gap:8px;margin:0;color:#0b253c;font-weight:400;line-height:1.35;}.woocommerce-checkout .ufin-checkout-single-option input[type=checkbox]{width:16px;height:16px;margin:0;accent-color:#ff9c23;}.woocommerce-checkout .ufin-checkout-privacy-notice{margin:18px 0 14px;padding:0;border:0;background:transparent;color:#0b253c;font-size:14px;line-height:1.45;}.woocommerce-checkout .ufin-checkout-privacy-notice a{color:#ff8a00;text-decoration:underline;}.woocommerce-checkout #payment #place_order{min-height:48px;padding:0 24px;border:0;border-radius:4px;background:#ff9c23;color:#fff;font-weight:700;cursor:pointer;}
